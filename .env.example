# Copy to .env only when setting up a new checkout. Keep existing .env values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_KEY
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
FRONTEND_URL=http://localhost:5000/
DEBUG=0
# Comma-separated browser origins only when a separate frontend needs API access.
ALLOWED_ORIGINS=
# Public OAuth client identifier; must match the frontend Google client ID.
GOOGLE_CLIENT_ID=549203417668-bl1k05ionrenlhnukkui7b6hka24rbbe.apps.googleusercontent.com

# Optional email delivery
SENDGRID_API_KEY=
FROM_EMAIL=

# Optional alternative to the bundled GCash QR image
PAYMENT_GCASH_QR_URL=
