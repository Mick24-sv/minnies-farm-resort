{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__path=/api"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.py?__path=/api/:match*"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "public/**",
      "maxDuration": 30
    }
  }
}

